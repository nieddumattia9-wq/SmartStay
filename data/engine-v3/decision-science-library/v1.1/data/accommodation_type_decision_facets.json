{
  "schemaVersion": "1.1.0",
  "status": "candidate-second-pass-required",
  "rankingInfluence": "none",
  "decisionUnit": "property × exact room/unit/bed/site × exact rate-offer × stay × party",
  "evidenceTargetSelection": {
    "matrix": "canonical_product_type × requested_role × party_and_need",
    "severityVocabulary": ["universal-hard", "conditional-hard", "role-decisive", "explanatory"],
    "rule": "Evidence targets are candidates for materiality selection, not universal hard requirements and not a mandatory user questionnaire.",
    "missingIrrelevantTargetEffect": "none",
    "missingMateriallyReversibleTargetEffect": "targeted-recheck-or-abstention"
  },
  "universalHardIdentity": [
    "property_identity",
    "unit_or_bed_or_site_identity",
    "rate_offer_identity",
    "requested_occupancy",
    "capacity_compatibility",
    "share_scope",
    "identity_provenance"
  ],
  "types": [
    {
