      "evidenceTargets": ["room_configuration", "meal_plan", "service_schedule"]
    },
    {
      "typeId": "serviced-apartment",
      "evidenceTargets": ["unit_layout", "kitchen_functionality", "housekeeping_frequency"]
    },
    {
      "typeId": "vacation-rental-entire-unit",
      "evidenceTargets": ["entire_unit_confirmation", "cleaning_obligations", "deposit_and_house_rules", "access_handoff"]
    },
    {
      "typeId": "vacation-rental-private-room",
      "evidenceTargets": ["shared_space_scope", "bathroom_sharing", "host_presence_and_access", "house_rules"]
    },
    {
      "typeId": "bed-and-breakfast-or-guesthouse",
      "evidenceTargets": ["bathroom_sharing", "breakfast_scope", "arrival_and_host_availability"]
    },
    {
      "typeId": "hostel-private-room",
      "evidenceTargets": ["bathroom_sharing", "common_space_and_quiet_rules", "access_hours"]
    },
    {
      "typeId": "hostel-dorm-bed",
