{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stayopti.example/schemas/v1.1/accommodation_offer_identity.schema.json",
  "title": "StayOpti accommodation offer identity research contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "identityModelVersion",
    "propertyIdentity",
    "unitOrBedOrSiteIdentity",
    "rateOfferIdentity",
    "rawDeclaredLabel",
    "canonicalProductType",
    "taxonomyAuthority",
    "taxonomyVersion",
    "shareScope",
    "statedCapacity",
    "requestedOccupancy",
    "stayBinding",
    "partyBinding",
    "observationTimestamp",
    "identityProvenanceRefs",
    "rankingInfluence"
  ],
  "properties": {
    "schemaVersion": { "const": "1.1.0" },
    "identityModelVersion": { "const": "accommodation-identity:v1.1" },
    "propertyIdentity": { "type": "string", "minLength": 1 },
    "unitOrBedOrSiteIdentity": { "type": "string", "minLength": 1 },
    "rateOfferIdentity": { "type": "string", "minLength": 1 },
    "rawDeclaredLabel": { "type": "string", "minLength": 1 },
    "canonicalProductType": {
      "enum": [
        "hotel",
        "serviced-apartment",
        "vacation-rental-entire-unit",
        "vacation-rental-private-room",
        "bed-and-breakfast-or-guesthouse",
        "hostel-private-room",
        "hostel-dorm-bed",
        "resort",
        "campground-pitch",
        "campground-rental-unit",
        "holiday-park",
        "glamping-unit",
        "other",
        "unknown"
      ]
    },
    "taxonomyAuthority": { "type": "string", "minLength": 1 },
    "taxonomyVersion": { "type": "string", "minLength": 1 },
    "shareScope": {
      "enum": [
        "entire-unit",
        "private-room-shared-common-space",
        "private-room-private-common-space",
        "shared-room-or-dorm",
        "private-site-or-pitch",
        "shared-site-or-pitch",
        "unknown"
      ]
    },
    "statedCapacity": {
      "oneOf": [
        { "type": "integer", "minimum": 1 },
        { "type": "null" }
      ]
    },
    "requestedOccupancy": { "type": "integer", "minimum": 1 },
    "stayBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkIn", "checkOut"],
      "properties": {
        "checkIn": { "type": "string", "format": "date" },
        "checkOut": { "type": "string", "format": "date" }
      }
    },
    "partyBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adults", "children", "requestedUnits"],
      "properties": {
        "adults": { "type": "integer", "minimum": 1 },
        "children": { "type": "integer", "minimum": 0 },
        "requestedUnits": { "type": "integer", "minimum": 1 }
      }
    },
    "observationTimestamp": { "type": "string", "format": "date-time" },
    "identityProvenanceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "rankingInfluence": { "const": "none" }
  },
  "allOf": [
    {
      "if": { "properties": { "canonicalProductType": { "enum": ["hotel", "vacation-rental-private-room", "bed-and-breakfast-or-guesthouse", "hostel-private-room"] } } },
      "then": { "properties": { "shareScope": { "enum": ["private-room-shared-common-space", "private-room-private-common-space"] } } }
    },
    {
      "if": { "properties": { "canonicalProductType": { "enum": ["serviced-apartment", "vacation-rental-entire-unit"] } } },
      "then": { "properties": { "shareScope": { "const": "entire-unit" } } }
    },
    {
      "if": { "properties": { "canonicalProductType": { "const": "hostel-dorm-bed" } } },
      "then": { "properties": { "shareScope": { "const": "shared-room-or-dorm" } } }
    },
    {
      "if": { "properties": { "canonicalProductType": { "const": "campground-pitch" } } },
      "then": { "properties": { "shareScope": { "enum": ["private-site-or-pitch", "shared-site-or-pitch"] } } }
    }
  ]
}
