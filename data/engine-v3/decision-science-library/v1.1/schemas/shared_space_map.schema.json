{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stayopti.example/schemas/v1.1/shared_space_map.schema.json",
  "title": "StayOpti per-space privacy and sharedness evidence map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mapVersion", "observations", "rankingInfluence"],
  "properties": {
    "schemaVersion": { "const": "1.1.0" },
    "mapVersion": { "type": "string", "minLength": 1 },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["space", "scope", "lockability", "accessHours", "provenanceRefs"],
        "properties": {
          "space": {
            "enum": ["sleeping-area", "bathroom", "kitchen", "entrance", "circulation-or-common-area", "outdoor-area", "work-area"]
          },
          "scope": {
            "enum": ["exclusive-to-party", "dedicated-private", "shared-with-guests", "shared-with-host", "public", "unknown", "not-applicable"]
          },
          "lockability": {
            "enum": ["verified-lockable", "not-lockable", "unknown", "not-applicable"]
          },
          "accessHours": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              { "type": "null" }
            ]
          },
          "provenanceRefs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "rankingInfluence": { "const": "none" }
  }
}
