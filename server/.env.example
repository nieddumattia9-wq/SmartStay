# SmartStay backend release configuration
# Never place real secrets in this example file.

NODE_ENV=production
DEPLOYMENT_ENV=staging
PORT=3001

CLIENT_ORIGINS=https://staging.example.com
TRUST_PROXY=1

SERVICE_NAME=smartstay-backend
RELEASE_SHA=replace-with-git-commit-sha
RUNTIME_STATE_MODE=in-memory-single-instance
LOG_ERROR_STACKS=false
SHUTDOWN_TIMEOUT_MS=10000
JSON_BODY_LIMIT=256kb

# Distributed state and durable search queue remain opt-in.
# Keep both disabled until the controlled rollout gate is approved.
# SMARTSTAY_OPERATIONAL_STATE_MODE=valkey-distributed
# SMARTSTAY_STATE_REDIS_URL=rediss://replace-with-managed-valkey.example:6379/0
# SMARTSTAY_STATE_ENVIRONMENT=staging
# SMARTSTAY_STATE_KEY_SECRET=replace-with-at-least-32-secret-bytes
# SMARTSTAY_ASYNC_SEARCH_QUEUE_ENABLED=false
# SMARTSTAY_QUEUE_REDIS_URL=rediss://replace-with-managed-valkey.example:6379/0
# SMARTSTAY_QUEUE_ENVIRONMENT=staging
# SMARTSTAY_QUEUE_KEY_SECRET=replace-with-at-least-32-secret-bytes
# SMARTSTAY_SEARCH_WORKER_HEARTBEAT_INTERVAL_MS=5000
# SMARTSTAY_SEARCH_WORKER_HEARTBEAT_TTL_MS=20000
# SMARTSTAY_SEARCH_WORKER_DRAIN_TIMEOUT_MS=30000

# Frontend build URL checked by the release gate.
VITE_API_URL=/api

# Destination provider
GEOAPIFY_API_KEY=replace-with-secret

# Active accommodation provider
LITEAPI_API_KEY=replace-with-secret
LITEAPI_BASE_URL=https://api.liteapi.travel/v3.0
LITEAPI_WHITELABEL_BASE_URL=https://replace-with-approved-checkout-domain.example
LITEAPI_DEFAULT_CURRENCY=EUR
LITEAPI_DEFAULT_GUEST_NATIONALITY=IT
LITEAPI_TIMEOUT_SECONDS=12
LITEAPI_RESULTS_LIMIT=80

# RouteStack remains disabled and is not required for release.
# ROUTESTACK_BASE_URL=
# ROUTESTACK_API_KEY=
# ROUTESTACK_API_SECRET=
