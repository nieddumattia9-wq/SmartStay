      "profiles": ["balanced"],
      "roles": ["best-choice"],
      "successCriteria": ["The counterfactual references its base case", "Unchanged facts remain stable", "The decisive variable is stated without inventing a global weight"]
    },
    {
      "id": "lesson-confidence-and-abstention",
      "version": "1.0.0",
      "title": "Confidence, near tie and no-good-option",
      "objective": "Abstain when material evidence or a defensible difference is missing.",
      "caseIds": ["case-balanced-near-tie", "case-comfort-no-good-option"],
      "claimIds": ["claim-choice-attributes-context-bound", "claim-location-is-trip-specific", "claim-room-attributes-context-sensitive"],
      "profiles": ["balanced", "comfort"],
      "roles": ["abstention"],
      "successCriteria": ["Low or absent confidence cannot recommend", "Near ties are not forced", "Invalid and hard-constraint-failing options are never selected"]
    },
    {
      "id": "lesson-split-net-value",
      "version": "1.0.0",
      "title": "Split saving versus switching friction",
      "objective": "Keep a split candidate offline and explicit about saving, room capability and switching friction.",
