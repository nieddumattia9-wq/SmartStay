    {
      "id": "lesson-profile-semantics",
      "version": "1.0.0",
      "title": "Five profile decision semantics",
      "objective": "Keep experience, price and minimum-quality behavior distinct across all five approved profiles.",
      "caseIds": ["case-balanced-marginal-value", "case-comfort-room-upgrade", "case-maximum-comfort-budget", "case-maximum-savings-minimum", "case-savings-quality-loss"],
      "claimIds": ["claim-budget-constraint-modeling", "claim-choice-attributes-context-bound", "claim-comfort-varies-by-trip-and-party", "claim-quality-importance-varies-by-segment", "claim-review-score-needs-volume-context", "claim-room-attributes-context-sensitive"],
